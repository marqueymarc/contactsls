#!/usr/bin/env python3
"""Read and print macOS Contacts without changing the Contacts database.

Examples:
  contactsls
  contactsls --sort modified --limit 25 --fields name,modified,emails
  contactsls --match marc --details --format json
  contactsls --sort name --all --fields name,phones

The macOS Contacts store is an implementation detail, so the tool discovers the
contact entity and available columns in each database instead of assuming a
fixed schema.  Every connection is opened with SQLite's read-only mode.
"""

from __future__ import annotations

import argparse
import csv
import datetime as dt
import json
import os
import re
import sqlite3
import subprocess
import sys
from dataclasses import dataclass, replace
from pathlib import Path
from typing import Iterable


CONTACTS_ROOT = Path.home() / "Library/Application Support/AddressBook/Sources"
CORE_DATA_EPOCH = dt.datetime(2001, 1, 1, tzinfo=dt.timezone.utc)
DEFAULT_FIELDS = ("name", "created")
DETAIL_FIELDS = ("name", "created", "modified", "organization", "emails", "phones", "notes", "source")
LOCATION_FIELDS = ("location", "location_time", "location_delta", "location_confidence", "location_kind", "location_coordinates", "location_link")
VALID_FIELDS = set(DETAIL_FIELDS + LOCATION_FIELDS)


@dataclass(frozen=True)
class Contact:
    name: str
    created: dt.datetime | None
    modified: dt.datetime | None
    organization: str
    emails: tuple[str, ...]
    phones: tuple[str, ...]
    notes: str
    source: str
    location: "TimelineLocation | None" = None

    def value(self, field: str, location_style: str = "summary") -> str:
        if field in LOCATION_FIELDS:
            return self.location.value(field, location_style) if self.location else ""
        raw = getattr(self, field)
        if isinstance(raw, dt.datetime):
            return raw.astimezone().strftime("%Y-%m-%d %H:%M:%S %Z")
        if raw is None:
            return ""
        if isinstance(raw, tuple):
            return "; ".join(raw)
        return raw


@dataclass(frozen=True)
class TimelineLocation:
    start: dt.datetime
    end: dt.datetime | None
    latitude: float
    longitude: float
    name: str = ""
    address: str = ""
    city: str = ""
    kind: str = "point"
    confidence: str = "medium"
    delta: dt.timedelta | None = dt.timedelta()

    def value(self, field: str, style: str) -> str:
        if field == "location_time":
            return self.start.astimezone().strftime("%Y-%m-%d %H:%M:%S %Z")
        if field == "location_delta":
            if self.delta is None:
                return f"during {self.kind}"
            seconds = round(abs(self.delta.total_seconds()))
            return f"{seconds // 60} min {'after' if self.delta.total_seconds() > 0 else 'before'} added"
        if field == "location_confidence":
            return self.confidence
        if field == "location_kind":
            return self.kind
        if field == "location_coordinates":
            return f"{self.latitude:.6f}, {self.longitude:.6f}"
        if field == "location_link":
            return f"https://maps.google.com/?q={self.latitude:.6f},{self.longitude:.6f}"
        if field == "location":
            if style == "coordinates":
                return self.value("location_coordinates", style)
            if style == "link":
                return self.value("location_link", style)
            if style == "place":
                return self.name
            if style == "address":
                return self.address or self.name
            if style == "city":
                return self.city
            return self.name or self.address or self.city or self.value("location_coordinates", style)
        return ""


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="contactsls",
        description="List contacts from local macOS Contacts databases (read-only).",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""Examples:
  contactsls
      Print the ten most recently created named contacts.
  contactsls --sort modified -n 25 --fields name,modified,emails
      Print the 25 most recently modified contacts with their email addresses.
  contactsls --match "Dale Barnes" --details --format json
      Find a contact and emit every supported field as JSON.
  contactsls --sort name --all --fields name,phones
      Print every named contact alphabetically with telephone numbers.

The command reads each local Contacts source database in SQLite read-only mode.
It does not use Contacts.app, sign in to a service, or change contact data.
Use --db to inspect one specific AddressBook-v22.abcddb database instead of
the normal local source set.  In Zsh, press Tab after --db for its path.""",
    )
    parser.add_argument("--sort", choices=("created", "modified", "name", "organization"), default="created",
                        help="ordering criterion (default: created)")
    parser.add_argument("-n", "--limit", type=int, default=10, help="number of contacts to print (default: 10)")
    parser.add_argument("--all", action="store_true", help="print every matching contact; overrides --limit")
    parser.add_argument("--oldest", action="store_true", help="reverse the default order for the selected sort")
    parser.add_argument("--fields", default=",".join(DEFAULT_FIELDS),
                        help="comma-separated columns: " + ", ".join(DETAIL_FIELDS + LOCATION_FIELDS))
    parser.add_argument("--details", action="store_true", help="show all available contact fields")
    parser.add_argument("--format", choices=("table", "tsv", "json"), default="table", help="output format")
    parser.add_argument("--match", metavar="TEXT", help="case-insensitive match against name, organization, email, or phone")
    parser.add_argument("--include-unnamed", action="store_true", help="include contacts with no name or organization")
    parser.add_argument("--db", action="append", type=Path, metavar="PATH",
                        help="read a specific AddressBook-v22.abcddb file; may be repeated")
    parser.add_argument("--timeline", type=Path, metavar="PATH", default=os.environ.get("CONTACTSLS_TIMELINE"),
                        help="Google Maps location-history.json; defaults to $CONTACTSLS_TIMELINE")
    parser.add_argument("--location", action="store_true",
                        help="reverse-geocode matched coordinates with Apple Maps (sends them to Apple)")
    parser.add_argument("--location-window", type=int, default=30, metavar="MINUTES",
                        help="maximum Timeline offset used for a match (default: 30)")
    args = parser.parse_args()
    if args.limit < 0:
        parser.error("--limit must be zero or greater")
    if args.location_window < 0:
        parser.error("--location-window must be zero or greater")
    args.fields = parse_fields(",".join(DETAIL_FIELDS) if args.details else args.fields, parser)
    return args


def timeline_timestamp(value: object) -> dt.datetime | None:
    if value is None:
        return None
    if isinstance(value, (int, float)):
        return dt.datetime.fromtimestamp(value / (1000 if value > 10_000_000_000 else 1), tz=dt.timezone.utc)
    if isinstance(value, str):
        try:
            return dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
        except ValueError:
            return None
    return None


def coordinate(value: object) -> tuple[float, float] | None:
    if isinstance(value, str):
        match = re.fullmatch(r"geo:([+-]?\d+(?:\.\d+)?),([+-]?\d+(?:\.\d+)?)", value)
        if match:
            return float(match.group(1)), float(match.group(2))
    if not isinstance(value, dict):
        return None
    latitude = value.get("latitudeE7", value.get("latitude", value.get("lat")))
    longitude = value.get("longitudeE7", value.get("longitude", value.get("lng", value.get("lon"))))
    if isinstance(latitude, (int, float)) and isinstance(longitude, (int, float)):
        latitude = latitude / 10_000_000 if abs(latitude) > 180 else latitude
        longitude = longitude / 10_000_000 if abs(longitude) > 180 else longitude
        if -90 <= latitude <= 90 and -180 <= longitude <= 180:
            return float(latitude), float(longitude)
    for nested in value.values():
        found = coordinate(nested)
        if found:
            return found
    return None


def text_value(value: object, keys: tuple[str, ...]) -> str:
    if not isinstance(value, dict):
        return ""
    for key in keys:
        candidate = value.get(key)
        if isinstance(candidate, str) and candidate.strip():
            return candidate.strip()
    return ""


def timeline_locations(path: Path) -> list[TimelineLocation]:
    try:
        payload = json.loads(path.expanduser().read_text())
    except (OSError, json.JSONDecodeError) as error:
        raise ValueError(f"cannot read Timeline file {path}: {error}") from error
    # Current iPhone exports are a top-level segment array; older exports wrap
    # the same data in semanticSegments and may additionally contain locations.
    segments = payload.get("semanticSegments", []) if isinstance(payload, dict) else payload if isinstance(payload, list) else []
    raw_locations = payload.get("locations", []) if isinstance(payload, dict) else []
    locations: list[TimelineLocation] = []
    for segment in segments:
        if not isinstance(segment, dict):
            continue
        kind, details = next(((kind, value) for kind, value in (("visit", segment.get("visit")), ("activity", segment.get("activity"))) if isinstance(value, dict)), ("segment", segment))
        point = coordinate(details) or coordinate(segment)
        start = timeline_timestamp(segment.get("startTime") or details.get("startTime"))
        end = timeline_timestamp(segment.get("endTime") or details.get("endTime"))
        if point and start:
            locations.append(TimelineLocation(start, end, *point, text_value(details, ("name", "placeName")), text_value(details, ("address", "formattedAddress")), text_value(details, ("city", "locality")), kind, "high" if kind == "visit" else "medium"))
    for point_data in raw_locations:
        if not isinstance(point_data, dict):
            continue
        point, moment = coordinate(point_data), timeline_timestamp(point_data.get("timestampMs") or point_data.get("timestamp"))
        if point and moment:
            locations.append(TimelineLocation(moment, None, *point))
    return locations


def nearest_timeline_location(created: dt.datetime | None, locations: list[TimelineLocation], window: dt.timedelta) -> TimelineLocation | None:
    if not created:
        return None
    created = created.astimezone(dt.timezone.utc)
    candidates: list[TimelineLocation] = []
    for location in locations:
        if location.end and location.start <= created <= location.end:
            confidence = "high" if location.kind == "visit" else "medium"
            return TimelineLocation(**{**location.__dict__, "delta": None, "confidence": confidence})
        delta = location.start - created
        if abs(delta) <= window:
            candidates.append(TimelineLocation(**{**location.__dict__, "delta": delta, "confidence": "medium" if location.kind != "point" else "low"}))
    return min(candidates, key=lambda item: abs(item.delta.total_seconds()), default=None)


def reverse_geocode(contacts: list[Contact]) -> list[Contact]:
    root = Path(__file__).resolve().parent
    source_helper = root / "helpers" / "reverse-geocode.swift"
    packaged_helper = root.parent / "libexec" / "reverse-geocode"
    command = [str(packaged_helper)] if packaged_helper.is_file() else ["swift", str(source_helper)]
    unique = {(contact.location.latitude, contact.location.longitude) for contact in contacts if contact.location}
    payload = "".join(f"{latitude},{longitude}\n" for latitude, longitude in unique)
    try:
        result = subprocess.run(command, input=payload, text=True, capture_output=True, check=True)
    except (OSError, subprocess.CalledProcessError) as error:
        raise ValueError(f"Apple reverse geocoding failed: {error}") from error
    labels = {}
    for line in result.stdout.splitlines():
        coordinate_text, separator, label = line.partition("\t")
        if separator:
            latitude, longitude = coordinate_text.split(",", 1)
            labels[(float(latitude), float(longitude))] = label
    return [replace(contact, location=replace(contact.location, address=labels.get((contact.location.latitude, contact.location.longitude), ""))) if contact.location else contact for contact in contacts]


def parse_fields(raw: str, parser: argparse.ArgumentParser) -> tuple[str, ...]:
    fields = tuple(field.strip() for field in raw.split(",") if field.strip())
    unknown = set(fields) - VALID_FIELDS
    if unknown:
        parser.error("unknown field(s): " + ", ".join(sorted(unknown)))
    if not fields:
        parser.error("--fields needs at least one field")
    return fields


def database_paths(explicit: list[Path] | None) -> list[Path]:
    paths = explicit or sorted(CONTACTS_ROOT.glob("*/AddressBook-v22.abcddb"))
    return [path.expanduser() for path in paths if path.is_file()]


def open_readonly(path: Path) -> sqlite3.Connection:
    # mode=ro allows SQLite to consult a current WAL without acquiring a write lock.
    return sqlite3.connect(f"file:{path}?mode=ro", uri=True)


def columns(connection: sqlite3.Connection, table: str) -> set[str]:
    return {row[1] for row in connection.execute(f"PRAGMA table_info({table})")}


def contact_entity(connection: sqlite3.Connection) -> int | None:
    try:
        row = connection.execute("SELECT Z_ENT FROM Z_PRIMARYKEY WHERE Z_NAME = 'ABCDContact'").fetchone()
    except sqlite3.DatabaseError:
        return None
    return row[0] if row else None


def coredatetime(value: float | None) -> dt.datetime | None:
    if value is None:
        return None
    return CORE_DATA_EPOCH + dt.timedelta(seconds=value)


def labelled_values(connection: sqlite3.Connection, table: str, value_column: str, owner: int) -> tuple[str, ...]:
    table_columns = columns(connection, table)
    if value_column not in table_columns:
        return ()
    owner_columns = [column for column in ("ZOWNER", "Z22_OWNER") if column in table_columns]
    if not owner_columns:
        return ()
    where = " OR ".join(f"{column} = ?" for column in owner_columns)
    ordering = "ZORDERINGINDEX, Z_PK" if "ZORDERINGINDEX" in table_columns else "Z_PK"
    label_column = "ZLABEL" if "ZLABEL" in table_columns else "NULL"
    query = f"SELECT {label_column}, {value_column} FROM {table} WHERE {where} ORDER BY {ordering}"
    try:
        rows = connection.execute(query, [owner] * len(owner_columns))
    except sqlite3.DatabaseError:
        return ()
    values: list[str] = []
    for label, value in rows:
        if not value:
            continue
        rendered = str(value)
        if label:
            rendered = f"{normalise_label(str(label))}: {rendered}"
        if rendered not in values:
            values.append(rendered)
    return tuple(values)


def contact_notes(connection: sqlite3.Connection, owner: int) -> str:
    note_columns = columns(connection, "ZABCDNOTE")
    contact_columns = [column for column in ("ZCONTACT", "Z22_CONTACT") if column in note_columns]
    if "ZTEXT" not in note_columns or not contact_columns:
        return ""
    query = "SELECT ZTEXT FROM ZABCDNOTE WHERE " + " OR ".join(f"{column} = ?" for column in contact_columns)
    try:
        values = [row[0].strip() for row in connection.execute(query, [owner] * len(contact_columns)) if row[0] and row[0].strip()]
    except sqlite3.DatabaseError:
        return ""
    return "\n".join(dict.fromkeys(values))


def normalise_label(label: str) -> str:
    """Turn Apple's _$!<Mobile>!$_ labels into ordinary CLI text."""
    match = re.fullmatch(r"_\$!<(.+)>!\$_", label)
    return match.group(1).lower() if match else label


def read_database(path: Path) -> Iterable[Contact]:
    try:
        connection = open_readonly(path)
    except sqlite3.Error as error:
        print(f"warning: cannot read {path}: {error}", file=sys.stderr)
        return
    with connection:
        record_columns = columns(connection, "ZABCDRECORD")
        entity = contact_entity(connection)
        required = {"Z_PK", "Z_ENT"}
        if entity is None or not required <= record_columns:
            return
        def field(column: str) -> str:
            return column if column in record_columns else "NULL"
        query = f"""
            SELECT Z_PK, {field('ZFIRSTNAME')}, {field('ZLASTNAME')}, {field('ZNAME')},
                   {field('ZORGANIZATION')}, {field('ZCREATIONDATE')}, {field('ZMODIFICATIONDATE')}
            FROM ZABCDRECORD
            WHERE Z_ENT = ?
        """
        for identifier, first, last, name, organization, created, modified in connection.execute(query, (entity,)):
            organization = (organization or "").strip()
            display_name = " ".join(part.strip() for part in (first or "", last or "", name or "") if part and part.strip())
            # Companies commonly have only an organization field; give those a
            # useful primary label instead of printing a blank name column.
            display_name = display_name or organization
            yield Contact(
                name=display_name,
                created=coredatetime(created),
                modified=coredatetime(modified),
                organization=organization,
                emails=labelled_values(connection, "ZABCDEMAILADDRESS", "ZADDRESS", identifier),
                phones=labelled_values(connection, "ZABCDPHONENUMBER", "ZFULLNUMBER", identifier),
                notes=contact_notes(connection, identifier),
                source=path.parent.name,
            )


def sort_contacts(contacts: list[Contact], criterion: str, oldest: bool) -> list[Contact]:
    if criterion in {"created", "modified"}:
        # Missing dates sort last when newest-first, first when --oldest is requested.
        key = lambda contact: (getattr(contact, criterion) is not None, getattr(contact, criterion) or CORE_DATA_EPOCH, contact.name.casefold())
        return sorted(contacts, key=key, reverse=not oldest)
    key = lambda contact: (getattr(contact, criterion).casefold(), contact.name.casefold())
    return sorted(contacts, key=key, reverse=oldest)


def matches(contact: Contact, text: str | None) -> bool:
    if not text:
        return True
    haystack = "\n".join((contact.name, contact.organization, *contact.emails, *contact.phones)).casefold()
    return text.casefold() in haystack


def has_visible_identity(contact: Contact) -> bool:
    return any(character.isprintable() and not character.isspace()
               for value in (contact.name, contact.organization) for character in value)


def emit_table(rows: list[Contact], fields: tuple[str, ...], delimiter: str, location_style: str) -> None:
    rendered = [[contact.value(field, location_style) for field in fields] for contact in rows]
    if delimiter:
        writer = csv.writer(sys.stdout, delimiter=delimiter, lineterminator="\n")
        writer.writerow(fields)
        writer.writerows(rendered)
        return
    widths = [len(field) for field in fields]
    for row in rendered:
        for index, value in enumerate(row):
            widths[index] = max(widths[index], len(value))
    print("  ".join(field.upper().ljust(widths[index]) for index, field in enumerate(fields)))
    print("  ".join("-" * width for width in widths))
    for row in rendered:
        print("  ".join(value.ljust(widths[index]) for index, value in enumerate(row)))


def main() -> int:
    args = parse_args()
    paths = database_paths(args.db)
    if not paths:
        print("No AddressBook-v22.abcddb source databases found.", file=sys.stderr)
        return 1
    contacts = [contact for path in paths for contact in read_database(path)]
    if args.timeline:
        try:
            locations = timeline_locations(args.timeline)
        except ValueError as error:
            print(f"error: {error}", file=sys.stderr)
            return 2
        window = dt.timedelta(minutes=args.location_window)
        contacts = [replace(contact, location=nearest_timeline_location(contact.created, locations, window)) for contact in contacts]
        if args.location:
            try:
                contacts = reverse_geocode(contacts)
            except ValueError as error:
                print(f"error: {error}", file=sys.stderr)
                return 2
    elif args.location or any(field in LOCATION_FIELDS for field in args.fields):
        print("error: location fields require --timeline PATH or $CONTACTSLS_TIMELINE", file=sys.stderr)
        return 2
    if not args.include_unnamed:
        contacts = [contact for contact in contacts if has_visible_identity(contact)]
    contacts = [contact for contact in contacts if matches(contact, args.match)]
    contacts = sort_contacts(contacts, args.sort, args.oldest)
    if not args.all:
        contacts = contacts[:args.limit]
    if args.format == "json":
        print(json.dumps([{field: contact.value(field) for field in args.fields} for contact in contacts], indent=2))
    else:
        emit_table(contacts, args.fields, "\t" if args.format == "tsv" else "", "summary")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
